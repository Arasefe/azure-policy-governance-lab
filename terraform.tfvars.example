# Copy this file to terraform.tfvars and adjust as needed.
# terraform.tfvars itself is gitignored — this .example file is the one that
# gets committed, so the real values a person fills in never leak into git.

subscription_id    = "00000000-0000-0000-0000-000000000000" # replace with your subscription's GUID
approved_location  = "eastus"
approved_vm_skus   = ["Standard_B1s", "Standard_B2s"]
identity_location  = "eastus"

ama_role_propagation_wait = "30s"
