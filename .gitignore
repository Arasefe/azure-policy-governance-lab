# Local state — this project has no remote backend configured (see versions.tf),
# so state lives here by default. Never commit it: it can contain secrets in
# plain text and diverges per-environment.
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Local .terraform directories (downloaded providers/modules) — regenerated by
# `terraform init`, not portable across machines/architectures.
**/.terraform/*

# terraform.lock.hcl IS committed on purpose (omit this project's lock file
# from the ignore list) so provider version selection is reproducible.

# Plan output and any generated plan JSON (may contain sensitive parameter
# values or resource state) — never commit a plan file.
*.tfplan
*.tfplan.json
tfplan.binary

# Real variable values — commit terraform.tfvars.example instead, never the
# actual .tfvars a person fills in locally.
terraform.tfvars
*.auto.tfvars
!terraform.tfvars.example

# Override files are a local escape hatch and shouldn't be shared.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# OS cruft
.DS_Store
